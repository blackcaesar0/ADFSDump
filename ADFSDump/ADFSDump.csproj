<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net452</TargetFramework>
    <RootNamespace>ADFSDump</RootNamespace>
    <AssemblyName>ADFSDump</AssemblyName>
    <StartupObject>ADFSDump.Program</StartupObject>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <!-- Keep the existing Properties/AssemblyInfo.cs instead of generating one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.DirectoryServices" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the .NET Framework target compile on any OS (Windows/Linux/macOS). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net452" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
